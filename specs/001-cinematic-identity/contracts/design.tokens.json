{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Proposed cinematic identity system — natural portrait, dark spatial field, restrained ice-cyan aura and light glass navigation.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.949,
          0.961
        ],
        "hex": "#edf2f5"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.655,
          0.706,
          0.753
        ],
        "hex": "#a7b4c0"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.624,
          0.91,
          0.961
        ],
        "hex": "#9fe8f5"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.031,
          0.047,
          0.067
        ],
        "hex": "#080c11"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.094,
          0.125
        ],
        "hex": "#111820"
      }
    },
    "glass": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.906,
          0.929,
          0.949
        ],
        "hex": "#e7edf2"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.094,
          0.125
        ],
        "hex": "#111820"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.478,
          0.537,
          0.588
        ],
        "hex": "#7a8996"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "wide": {
      "$value": {
        "value": 80,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "annotation": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "capsule": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 2.5,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
